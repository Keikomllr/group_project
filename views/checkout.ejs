<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment Gateway</title>
    <link rel="stylesheet" href="/stylesheets/gataway.css">
</head>
<body>
   <div class="container">
    <form action="">
        <div class="row">
            <div class="column">
                <h3 class="title">Billing Address</h3>
                <div class="input-box">
                    <span>Full Name : </span>
                    <input type="text" placeholder="Type your full name">
                </div>
                <div class="input-box">
                    <span>Email : </span>
                    <input type="email" placeholder="example@example.com">
                </div>
                <div class="input-box">
                    <span>Address : </span>
                    <input type="text" placeholder="Room - Street - Location">
                </div>
                <div class="input-box">
                    <span>City: </span>
                    <input type="text" placeholder="Stockholm">
                </div>
                <div class="flex">
                    <div class="input-box">
                        <span>Country : </span>
                        <input type="text" placeholder="Sweden">
                    </div>
                    <div class="input-box">
                        <span>Zip Code : </span>
                        <input type="number" placeholder="123-456">
                    </div>
                </div>
            </div>
            <div class="column">
                <h3 class="title">Payment</h3>
                <div class="input-box">
                    <span>Payment Options: </span>
                    <a href="#" target="_blank">
                    <img class="payO" src="/img/swish.jpg" alt="">
                    </a>
                    <a href="#" target="_blank">
                    <img class="payO" src="/img/klarna.png" alt="">
                    </a>
                    <a href="#" target="_blank">
                    <img class="payPal" src="/img/paypal.png" alt="">
                    </a>
                    <a href="#" target="_blank">
                    <img class="payO" src="/img/visa.png" alt="">
                    </a>
                    <a href="#" target="_blank">
                    <img class="payO" src="/img/master.png" alt="">
                    </a>
                </div>
                <div class="input-box">
                    <span>Card Holder Name : </span>
                    <input type="text" placeholder="Mr. Example Example">
                </div>
                <div class="input-box">
                    <span>Credit Card Number : </span>
                    <input type="number" placeholder="1111-2222-3333-4444">
                </div>
                <div class="input-box">
                    <span>Exp. Month : </span>
                    <input type="text" placeholder="July">
                </div>
                <div class="flex">
                    <div class="input-box">
                        <span>Exp. Year : </span>
                        <input type="number" placeholder="2027">
                    </div>
                    <div class="input-box">
                        <span>CVV : </span>
                        <input type="number" placeholder="123">
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Delivery Options Section -->
        <div class="column">
            <h3 class="title">Delivery Options</h3>
            <div class="delivery-option">
                <label class="delivery-card">
                    <input type="radio" name="delivery" value="express" class="delivery-radio">
                    <div class="delivery-content">
                        <img src="/img/fast-delivery.png" alt="Express Delivery">
                        <span>Express Delivery: 1-2 working days </span>
                    </div>
                </label>
            </div>
            <div class="delivery-option">
                <label class="delivery-card">
                    <input type="radio" name="delivery" value="standard" class="delivery-radio" checked>
                    <div class="delivery-content">
                        <img src="/img/slowtruck.svg" alt="Standard Delivery">
                        <span>Standard Delivery: 3-5 working days</span>
                    </div>
                </label>
            </div>
            <div class="delivery-option">
                <label class="delivery-card">
                    <input type="radio" name="delivery" value="home" class="delivery-radio">
                    <div class="delivery-content">
                        <img src="/img/house-check.svg" alt="Home Delivery">
                        <span>Home Delivery: 2-3 working days</span>
                    </div>
                </label>
            </div>
        </div>
        
        <button type="submit" class="btn">Submit</button>
    </form>
   </div>
</body>
</html>