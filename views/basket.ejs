<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/basket.css">
</head>
<body>
    <div class="basket-container">
        <header>
            <h1><%= title %></h1>
        </header>
        <main>
            <table class="basket-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Quantity</th>
                        <th>Price</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    <% basket.forEach(basketItem => { %>
                        <tr>
                            <td><%= basketItem.product.name %></td>
                            <td><%= basketItem.quantity %></td>
                            <td><%= basketItem.product.price %> kr</td>
                            <td><%= (basketItem.product.price * basketItem.quantity).toFixed(2) %> kr</td>
                        </tr>
                    <% }) %>
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" class="total-label">Total Amount:</td>
                        <td class="total-value">
                            <%= basket.reduce((sum, item) => sum + (item.product.price * item.quantity), 0).toFixed(2) %> kr
                        </td>
                    </tr>
                </tfoot>
            </table>
            
            <div class="checkout-container">
                <!-- Redirect to Homepage Button -->
                <div class="redirect-to-home-container">
                    <form action="/" method="GET" class="redirect-home-form">
                        <button type="submit" class="redirect-home-button">Go Back</button>
                    </form>
                </div>
            
                <!-- Checkout Button -->
                <form action="/checkout" method="GET">
                    <button type="submit" class="checkout-button">Checkout</button>
                </form>
            
                <!-- Empty Basket Icon (SVG Image) -->
                <div class="empty-basket-icon-container">
                    <form action="/basket/clear" method="POST" class="empty-basket-form">
                        <button type="submit" class="empty-basket-icon" title="Empty Basket">
                            <img src="/img/trash3.svg" alt="Empty Basket" class="trash-can-icon" width="24" height="24">
                        </button>
                    </form>
                </div>
            </div>
        </main>
    </div>
</body>
</html>